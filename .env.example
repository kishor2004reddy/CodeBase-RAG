# ── Groq LLM API ─────────────────────────────────────────────────────────────
# Get your free API key at: https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# Models (defaults are set in config.py, override here if needed)
# GROQ_MODEL_GENERAL=llama-3.3-70b-versatile
# GROQ_MODEL_CODE=deepseek-r1-distill-llama-70b

# ── Qdrant Vector Database ────────────────────────────────────────────────────
# When running locally (without Docker): http://localhost:6333
# When running via Docker Compose: http://qdrant:6333  (set automatically)
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=codebase

# ── Neo4j Graph Database ─────────────────────────────────────────────────────
# When running locally (without Docker): bolt://localhost:7687
# When running via Docker Compose: bolt://neo4j:7687  (set automatically)
# Auth is disabled by default in dev (NEO4J_AUTH=none in docker-compose)
NEO4J_URI=bolt://localhost:7687
# NEO4J_USER=
# NEO4J_PASSWORD=
# NEO4J_DATABASE=neo4j

# ── Embeddings ────────────────────────────────────────────────────────────────
# EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# ── App ───────────────────────────────────────────────────────────────────────
APP_ENV=development
LOG_LEVEL=INFO
